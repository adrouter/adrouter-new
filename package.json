    "@ai-sdk/cerebras": "2.0.60",
    "@ai-sdk/cohere": "3.0.27",
    "@ai-sdk/deepinfra": "2.0.41",
    "@ai-sdk/gateway": "3.0.191",
    "@ai-sdk/google": "3.0.73",
    "@ai-sdk/google-vertex": "4.0.181",
    "@ai-sdk/groq": "3.0.31",
    "@ai-sdk/mistral": "3.0.51",
    "@ai-sdk/openai": "3.0.88",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/perplexity": "3.0.26",
    "@ai-sdk/togetherai": "2.0.68",
    "@ai-sdk/xai": "3.0.102",
    "@aihubmix/ai-sdk-provider": "2.2.1",
    "@earendil-works/pi-ai": "1.0.2",
    "@jerome-benoit/sap-ai-provider-v2": "5.0.3",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "@saladtechnologies-oss/ai-sdk-provider": "0.2.0",
    "ai": "6.0.168",
    "ai-gateway-provider": "3.2.0",
    "ajv": "8.20.0",
    "ignore": "7.0.5",
    "merge-gateway-ai-sdk-provider": "0.3.0",
    "venice-ai-sdk-provider": "2.1.1",
    "watsonx-ai-provider": "2.0.0"
