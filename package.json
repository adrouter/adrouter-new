{
  "name": "@adrouter/adr-cli",
  "version": "0.1.0-alpha.42",
  "private": true,
  "description": "adr-v2 test-credit compute marketplace terminal",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrouter/adrouter-new.git"
  },
  "bin": {
    "adrouter-new": "bin/adrouter-new.mjs",
    "adr-cli": "bin/adr-cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "runtime/manifest.json",
    "runtime/guest-images.json",
    "README.md",
    "LICENSE",
    "pi-provenance.lock.json",
    "release-policy.json",
    "coding-runtime/",
    "provider-runtime/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-source.mjs && node scripts/verify-provenance.mjs && npm test",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "coding:build": "node scripts/build-coding-runtime.mjs ../adrouterCLI --verify",
    "coding:mac": "node scripts/verify-coding-mac.mjs",
    "coding:pty": "python3 scripts/verify-coding-pty.py --long",
    "coding:verify": "node scripts/verify-coding-provenance.mjs",
    "provider:build": "node scripts/build-provider-runtime.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "candidate",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.166",
    "@ai-sdk/anthropic": "3.0.111",
